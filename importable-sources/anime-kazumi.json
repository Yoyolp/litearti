[
  {
    "_comment": "由 Kazumi 社区规则 MXdm v2.4 (Predidit/KazumiRules) 转换而来。这是唯一一条能直接取到 m3u8 直链的社区源，因此是流代理与播放链路最好的测试对象。播放页内联了 `url: 'https://.../index.m3u8'`，用 xpath 取不到，所以 playback 用 regex 从源码里捞。",
    "schemaVersion": 1,
    "id": "kazumi-mxdm",
    "name": "MXdm（Kazumi 社区）",
    "version": "2.4",
    "homepage": "https://www.dcc3.com",
    "language": "zh",
    "type": "video",
    "enabled": true,
    "request": {
      "headers": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
        "Referer": "https://www.dcc3.com/"
      },
      "timeoutMs": 20000,
      "delayMs": 400
    },
    "search": {
      "url": "https://www.dcc3.com/search/?wd={{keyword}}",
      "method": "GET",
      "list": "xpath://div[contains(@class,'search')]/ul/li",
      "fields": {
        "title": "xpath://h3/a",
        "detailUrl": "xpath://h3/a/::attr(href)"
      }
    },
    "detail": {
      "list": "xpath://div[@class='playlist']/div[@class='row']/ul/li/a",
      "fields": {
        "title": "xpath:",
        "url": "xpath:/::attr(href)"
      },
      "title": "xpath://h1",
      "cover": "xpath://div[contains(@class,'detail')]//img/::attr(src)"
    },
    "chapter": {
      "content": "xpath://body"
    },
    "video": {
      "episodes": "xpath://div[@class='playlist']/div[@class='row']/ul/li/a",
      "episodeTitle": "xpath:",
      "episodeUrl": "xpath:/::attr(href)",
      "playback": {
        "kind": "regex",
        "pattern": "url:\\s*'([^']+\\.m3u8[^']*)'"
      }
    }
  },
  {
